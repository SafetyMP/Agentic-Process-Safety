{
  "schema_version": "1.0",
  "id": "procurement-sandbox-v1",
  "nodes": [
    {
      "id": "demand",
      "objective": "Forecast required quantities",
      "trust_boundary": "internal",
      "permissions": [
        "read_state",
        "write:demand"
      ],
      "tools": [
        "demand_mock"
      ],
      "data": [
        "demand_result"
      ],
      "constraints": [
        "sandbox_only",
        "no_real_payments",
        "max_delegation_depth:3"
      ]
    },
    {
      "id": "inventory",
      "objective": "Maintain stock and derive replenishment",
      "trust_boundary": "internal",
      "permissions": [
        "read_state",
        "write:inventory"
      ],
      "tools": [
        "inventory_mock"
      ],
      "data": [
        "inventory_result"
      ],
      "constraints": [
        "sandbox_only",
        "no_real_payments",
        "max_delegation_depth:3"
      ]
    },
    {
      "id": "supplier",
      "objective": "Select an eligible supplier",
      "trust_boundary": "untrusted_supplier_input",
      "permissions": [
        "read_state",
        "write:supplier"
      ],
      "tools": [
        "supplier_mock"
      ],
      "data": [
        "supplier_result"
      ],
      "constraints": [
        "sandbox_only",
        "no_real_payments",
        "max_delegation_depth:3"
      ]
    },
    {
      "id": "finance",
      "objective": "Authorize expenditure within budget",
      "trust_boundary": "internal",
      "permissions": [
        "read_state",
        "write:finance"
      ],
      "tools": [
        "finance_mock"
      ],
      "data": [
        "finance_result"
      ],
      "constraints": [
        "sandbox_only",
        "no_real_payments",
        "max_delegation_depth:3"
      ]
    },
    {
      "id": "purchase",
      "objective": "Execute exactly one authorized simulated order",
      "trust_boundary": "internal",
      "permissions": [
        "read_state",
        "write:purchase"
      ],
      "tools": [
        "purchase_mock"
      ],
      "data": [
        "purchase_result"
      ],
      "constraints": [
        "sandbox_only",
        "no_real_payments",
        "max_delegation_depth:3"
      ]
    },
    {
      "id": "orchestrator",
      "objective": "Sequence bounded delegation and reconcile shared state",
      "trust_boundary": "control_plane",
      "permissions": [
        "delegate",
        "read_state"
      ],
      "tools": [
        "delegate_mock"
      ],
      "data": [
        "versioned_shared_state"
      ],
      "constraints": [
        "sandbox_only",
        "max_delegation_depth:3"
      ]
    }
  ],
  "communications": [
    {
      "source": "demand",
      "target": "inventory",
      "data": "demand_result",
      "trust_boundary": "message_validation"
    },
    {
      "source": "inventory",
      "target": "supplier",
      "data": "inventory_result",
      "trust_boundary": "message_validation"
    },
    {
      "source": "supplier",
      "target": "finance",
      "data": "supplier_result",
      "trust_boundary": "message_validation"
    },
    {
      "source": "finance",
      "target": "purchase",
      "data": "finance_result",
      "trust_boundary": "message_validation"
    },
    {
      "source": "orchestrator",
      "target": "demand",
      "data": "delegation",
      "trust_boundary": "control_to_worker"
    },
    {
      "source": "orchestrator",
      "target": "inventory",
      "data": "delegation",
      "trust_boundary": "control_to_worker"
    },
    {
      "source": "orchestrator",
      "target": "supplier",
      "data": "delegation",
      "trust_boundary": "control_to_worker"
    },
    {
      "source": "orchestrator",
      "target": "finance",
      "data": "delegation",
      "trust_boundary": "control_to_worker"
    },
    {
      "source": "orchestrator",
      "target": "purchase",
      "data": "delegation",
      "trust_boundary": "control_to_worker"
    }
  ],
  "shared_state": {
    "consistency": "versioned_compare_and_swap",
    "owner": "orchestrator"
  },
  "constraints": [
    "no_network",
    "no_purchase_or_payment_side_effects"
  ]
}
