{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "cases_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "passed": {
      "type": "boolean"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "enum": [
              "allow",
              "deny",
              "review_required"
            ]
          },
          "actual": {
            "type": "object",
            "properties": {
              "decision": {
                "enum": [
                  "allow",
                  "deny",
                  "review_required"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "decision",
              "reason"
            ],
            "additionalProperties": false
          },
          "passed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "expected",
          "actual",
          "passed"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "policy_digest",
    "policy_version",
    "cases_digest",
    "passed",
    "results"
  ],
  "additionalProperties": false
}
