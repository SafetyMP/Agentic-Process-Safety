{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "sandbox": {
      "const": true
    },
    "state": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "demand": {
          "type": "integer",
          "minimum": 0
        },
        "stock": {
          "type": "integer",
          "minimum": 0
        },
        "quantity": {
          "type": "integer",
          "minimum": 0
        },
        "quote": {
          "type": "integer",
          "minimum": 0
        },
        "supplier": {
          "type": "string"
        },
        "authorization": {
          "type": "string"
        },
        "orders": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SIMULATED:"
          }
        }
      },
      "required": [
        "version",
        "demand",
        "stock",
        "quantity",
        "quote",
        "supplier",
        "authorization",
        "orders"
      ],
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "agent": {
            "enum": [
              "demand",
              "inventory",
              "supplier",
              "finance",
              "purchase"
            ]
          },
          "tool": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "agent",
          "tool",
          "version"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "sandbox",
    "state",
    "events"
  ],
  "additionalProperties": false
}
