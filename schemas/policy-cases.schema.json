          },
          "approver": {
            "type": "string",
            "minLength": 1
          },
          "identity_ok": {
            "type": "boolean"
          },
          "context_ok": {
            "type": "boolean"
          },
          "capability_ok": {
            "type": "boolean"
          },
          "state_ok": {
            "type": "boolean"
          },
          "stage_ok": {
            "type": "boolean"
          },
          "payload_ok": {
            "type": "boolean"
          },
          "approval_ok": {
            "type": "boolean"
          },
          "human_ok": {
            "type": "boolean"
          },
          "depth": {
            "type": "integer",
