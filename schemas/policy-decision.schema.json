{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "decision": {
      "enum": [
        "allow",
        "deny",
        "review_required"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "decision",
    "reason"
  ],
  "additionalProperties": false
}
