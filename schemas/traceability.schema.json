{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "report_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "hazard_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "hazard_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "state": {
            "enum": [
              "proposed",
              "approved"
            ]
          },
          "reviewer": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "implementation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "test": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "status": {
                  "enum": [
                    "implemented",
                    "gap"
                  ]
                },
                "gap": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "version",
                "description",
                "implementation",
                "test",
                "status",
                "gap"
              ],
              "additionalProperties": false
            }
          },
          "review_signature": {
            "type": [
              "string",
              "null"
            ]
          },
          "previous_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "version",
          "hazard_id",
          "hazard_digest",
          "text",
          "state",
          "reviewer",
          "review_reason",
          "controls",
          "review_signature",
          "previous_digest"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "report_digest",
    "requirements"
  ],
  "additionalProperties": false
}
